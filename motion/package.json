{
  "name": "fechouocarrinho-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Videos e imagens de divulgacao do Fechou o Carrinho (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts --port=3201",
    "prep": "node scripts/inline-mockups.mjs",
    "typecheck": "tsc -p .",
    "render:spot": "remotion render src/index.ts --port=3200 Spot15Vertical out/spot-15-vertical.mp4",
    "render:spot:vo": "remotion render src/index.ts --port=3200 --props=vo-props.json Spot15Vertical out/spot-15-vertical-vo.mp4",
    "still:poster": "remotion still src/index.ts --port=3200 Spot15Vertical out/spot-15-poster.png --frame=200"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.538",
    "typescript": "^5.6.3"
  }
}
